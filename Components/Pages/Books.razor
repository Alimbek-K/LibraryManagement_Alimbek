
@page "/books"
@rendermode InteractiveServer
@using LibraryManagement_Alimbek.Models
@using LibraryManagement_Alimbek.Data
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<LibraryDbContext> DbFactory

<PageTitle>Books Management</PageTitle>

<h1>Books Management</h1>
<p class="text-muted">Manage your library collection.</p>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-info">@message</div>
}

<div class="card p-4 mb-4">
    <h4>@(editingId == 0 ? "Add New Book" : "Edit Book")</h4>

    <EditForm Model="bookForm" OnValidSubmit="SaveBook" FormName="bookForm">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Book Title</label>
                <InputText class="form-control"
                           @bind-Value="bookForm.Title" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Author</label>
                <InputText class="form-control"
                           @bind-Value="bookForm.Author" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Category</label>
                <InputText class="form-control"
                           @bind-Value="bookForm.Category" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Published Year</label>
                <InputNumber class="form-control"
                             @bind-Value="bookForm.PublishedYear" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Quantity</label>
                <InputNumber class="form-control"
                             @bind-Value="bookForm.Quantity" />
            </div>
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-primary">
                @(editingId == 0 ? "Add Book" : "Save Changes")
            </button>

            @if (editingId != 0)
            {
                <button type="button"
                        class="btn btn-secondary ms-2"
                        @onclick="CancelEdit">
                    Cancel
                </button>
            }
        </div>
    </EditForm>
</div>

<div class="card p-4">
    <h4>Book Collection (@filteredBooks.Count)</h4>

    <input class="form-control mb-3"
           placeholder="Search by title, author or category..."
           @bind="searchText"
           @bind:event="oninput" />

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Author</th>
                    <th>Category</th>
                    <th>Year</th>
                    <th>Available</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var book in filteredBooks)
                {
                    <tr>
                        <td>@book.Title</td>
                        <td>@book.Author</td>
                        <td>@book.Category</td>
                        <td>@book.PublishedYear</td>
                        <td>@book.AvailableQuantity / @book.Quantity</td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary me-2"
                                    @onclick="() => EditBook(book)">
                                Edit
                            </button>
                            <button class="btn btn-sm btn-outline-danger"
                                    @onclick="() => DeleteBook(book.Id)">
                                Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (filteredBooks.Count == 0)
    {
        <p class="text-muted">No books found.</p>
    }
</div>

@code {
    private List<Book> books = new();
    private Book bookForm = new();
    private string searchText = "";
    private string message = "";
    private int editingId = 0;

    private List<Book> filteredBooks =>
        books.Where(b =>
            b.Title.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
            b.Author.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
            b.Category.Contains(searchText, StringComparison.OrdinalIgnoreCase))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadBooks();
    }

    private async Task LoadBooks()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        books = await db.Books
            .AsNoTracking()
            .OrderBy(b => b.Title)
            .ToListAsync();
    }

    private async Task SaveBook()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            if (editingId == 0)
            {
                bookForm.AvailableQuantity = bookForm.Quantity;
                db.Books.Add(bookForm);
                message = "Book added successfully!";
            }
            else
            {
                var existing = await db.Books.FindAsync(editingId);

                if (existing == null)
                {
                    message = "Book not found.";
                    return;
                }

                int borrowed = existing.Quantity - existing.AvailableQuantity;

                if (bookForm.Quantity < borrowed)
                {
                    message = "Quantity cannot be less than borrowed copies.";
                    return;
                }

                existing.Title = bookForm.Title;
                existing.Author = bookForm.Author;
                existing.Category = bookForm.Category;
                existing.PublishedYear = bookForm.PublishedYear;
                existing.Quantity = bookForm.Quantity;
                existing.AvailableQuantity = bookForm.Quantity - borrowed;

                message = "Book updated successfully!";
            }

            await db.SaveChangesAsync();
            CancelEdit();
            await LoadBooks();
        }
        catch (Exception ex)
        {
            message = $"Error: {ex.Message}";
        }
    }

    private void EditBook(Book book)
    {
        editingId = book.Id;

        bookForm = new Book
        {
            Id = book.Id,
            Title = book.Title,
            Author = book.Author,
            Category = book.Category,
            PublishedYear = book.PublishedYear,
            Quantity = book.Quantity,
            AvailableQuantity = book.AvailableQuantity
        };

        message = "";
    }

    private async Task DeleteBook(int id)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var book = await db.Books.FindAsync(id);

            if (book == null)
                return;

            bool hasLoans = await db.Loans.AnyAsync(l => l.BookId == id);

            if (hasLoans)
            {
                message = "Cannot delete a book with loan history.";
                return;
            }

            db.Books.Remove(book);
            await db.SaveChangesAsync();

            message = "Book deleted successfully!";
            await LoadBooks();
        }
        catch (Exception ex)
        {
            message = $"Error: {ex.Message}";
        }
    }

    private void CancelEdit()
    {
        editingId = 0;
        bookForm = new Book();
    }
}
